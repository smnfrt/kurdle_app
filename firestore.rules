rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function matchPath(matchId) {
      return /databases/$(database)/documents/matches/$(matchId);
    }

    function isMatchPlayer(matchId) {
      return signedIn()
        && exists(matchPath(matchId))
        && request.auth.uid in get(matchPath(matchId)).data.players;
    }

    function isMatchPlayerAfter(matchId) {
      return signedIn()
        && existsAfter(matchPath(matchId))
        && request.auth.uid in getAfter(matchPath(matchId)).data.players;
    }

    function isInviteParticipant() {
      return signedIn()
        && (request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId);
    }

    match /matches/{matchId} {
      allow read: if isMatchPlayer(matchId);

      allow create: if signedIn()
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.unreadCounts is map;

      allow update: if isMatchPlayer(matchId)
        && request.resource.data.players == resource.data.players
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'players',
          'hostUid',
          'guestUid',
          'createdAt',
          'updatedAt',
          'lastMessage',
          'lastMessageAt',
          'lastMessageBy',
          'unreadCounts'
        ]);
    }

    match /matches/{matchId}/messages/{messageId} {
      allow read: if isMatchPlayer(matchId);

      allow create: if isMatchPlayerAfter(matchId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.type == 'text'
        && request.resource.data.createdAt == request.time
        && request.resource.data.readBy is list
        && request.auth.uid in request.resource.data.readBy;

      allow update: if isMatchPlayer(matchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readBy'
        ]);

      allow delete: if false;
    }

    match /gameInvites/{inviteId} {
      allow read: if isInviteParticipant();

      allow create: if signedIn()
        && request.resource.data.inviteId == inviteId
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.fromDisplayName is string
        && request.resource.data.toDisplayName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.roomCode == null
        && request.resource.data.gameId == null;

      allow update: if signedIn()
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.fromDisplayName == resource.data.fromDisplayName
        && request.resource.data.toDisplayName == resource.data.toDisplayName
        && request.resource.data.gameType == resource.data.gameType
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && resource.data.status == 'pending'
        && (
          (
            request.auth.uid == resource.data.toUserId
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'acceptedAt',
              'declinedAt',
              'roomCode',
              'gameId'
            ])
          )
          || (
            request.auth.uid == resource.data.fromUserId
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'cancelledAt'
            ])
          )
          || (
            request.auth.uid in [resource.data.fromUserId, resource.data.toUserId]
            && request.resource.data.status == 'expired'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status'
            ])
          )
        );

      allow delete: if false;
    }
  }
}

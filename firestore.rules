rules_version = '2';

// Peyvok — Firestore Güvenlik Kuralları (v2)
// ----------------------------------------------------------------------------
// Tasarım: varsayılan REDDET. Her koleksiyon açıkça yetkilendirilir.
// Sahiplik modeli (kod analizinden):
//   - users/** + alt-koleksiyonları: doc id == auth.uid → sadece sahip.
//   - games: ownership alanı playerUid.
//   - rooms: iki-taraflı (hostUid/guestUid) + matchmaking için waiting odalar.
//   - gameInvites: fromUserId/toUserId.
//   - matches + messages: players[] listesi.
//   - tournaments: paylaşımlı doküman (authenticated).
//   - leaderboard/dailyWords/dailyStats/ferheng/ferheng_meta/config: public-read.
//
// ⚠️ ANTI-HİLE NOTU: xp/peyv/level/score/highScore/leaderboard.score gibi alanlar
// şu an CLIENT tarafında üretiliyor. Firestore rules increment'i güvenilir
// doğrulayamadığı için TAM hile-önleme ancak Cloud Functions (Admin SDK) ile
// sağlanır. Aşağıda sahiplik + tip + temel sınır doğrulaması yapılır; sunucu-
// otoriter skorlama yol haritasına bırakılmıştır (rapora bakınız).
// ⚠️ GİZLİLİK NOTU: users dokümanı hem public (displayName) hem özel (email,
// fcmToken) alan içeriyor. Firestore read'leri alan-bazlı kısıtlanamadığından
// users authenticated-read'tir; email/fcmToken'ı ayrı public-profil koleksiyonuna
// taşımak kod refactor'u gerektirir (yol haritası).
// ----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Yardımcılar ──────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function roomPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode);
    }

    // rooms üyeliği (mevcut doküman üzerinden)
    function isRoomMember() {
      return signedIn() && (
        request.auth.uid == resource.data.hostUid
        || request.auth.uid == resource.data.guestUid
      );
    }

    // matches (chat) yardımcıları
    function matchPath(matchId) {
      return /databases/$(database)/documents/matches/$(matchId);
    }
    function invitePath(inviteId) {
      return /databases/$(database)/documents/gameInvites/$(inviteId);
    }
    function isMatchPlayer(matchId) {
      return signedIn()
        && exists(matchPath(matchId))
        && request.auth.uid in get(matchPath(matchId)).data.players;
    }
    function isMatchPlayerAfter(matchId) {
      return signedIn()
        && existsAfter(matchPath(matchId))
        && request.auth.uid in getAfter(matchPath(matchId)).data.players;
    }
    function isInviteParticipant() {
      return signedIn()
        && (request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId);
    }
    function isLegacyInvitee() {
      return signedIn()
        && resource.data.status == 'waiting_invite'
        && request.auth.uid == resource.data.inviteeUid;
    }
    function canCreateAcceptedInviteRoom() {
      return signedIn()
        && request.resource.data.status == 'active'
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.inviteId is string
        && exists(invitePath(request.resource.data.inviteId))
        && get(invitePath(request.resource.data.inviteId)).data.status == 'pending'
        && get(invitePath(request.resource.data.inviteId)).data.fromUserId == request.resource.data.hostUid
        && get(invitePath(request.resource.data.inviteId)).data.toUserId == request.auth.uid
        && get(invitePath(request.resource.data.inviteId)).data.gameType == request.resource.data.gameType;
    }
    function canReadExistingRoom() {
      return signedIn() && (
        isRoomMember()
        || isLegacyInvitee()
        || resource.data.status == 'waiting_random'
        || resource.data.status == 'waiting'
      );
    }
    function canGetRoom(roomCode) {
      return canReadExistingRoom() || (
        signedIn() && !exists(roomPath(roomCode))
      );
    }

    // ── users/{uid} + alt-koleksiyonlar ──────────────────────────
    // Yazım: sadece sahip. Okuma: authenticated (kullanıcı arama + rakip adı).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      match /dailyWordPlays/{dateKey} {
        allow read, write: if isOwner(uid);
      }
      match /dailyChallengePlays/{dateKey} {
        allow read, write: if isOwner(uid);
      }
      match /achievements/{achievementId} {
        allow read, write: if isOwner(uid);
      }
      match /ferhengFavorites/{wordId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── games/{gameId} — kişisel oyun kaydı ──────────────────────
    // Create-only; sahip kendi playerUid'iyle yazar ve sadece kendi kayıtlarını okur.
    match /games/{gameId} {
      allow read: if signedIn() && resource.data.playerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.playerUid == request.auth.uid
        && request.resource.data.playerScore is int
        && request.resource.data.aiScore is int;
      allow update, delete: if false;
    }

    // ── leaderboard/{period}/entries/{uid} — sıralama ────────────
    // Public-read (liste). Yazım: sadece kendi entry'si (doc id == uid).
    match /leaderboard/{period} {
      allow read: if signedIn();
      match /entries/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.score is int;
      }
    }

    // ── rooms/{roomCode} — çok-oyunculu oyun durumu ──────────────
    // Okuma: oda üyeleri + oda kodu/rastgele eşleşme için bekleyen odalar.
    // Legacy waiting_invite odaları sadece host veya davet edilen kullanıcı görür.
    // Create: host kendi bekleme odasını açar veya kalıcı daveti kabul eden guest
    // active odayı oluşturur. Update: mevcut üye veya odaya katılan guest.
    // Delete: host, bekleyen kendi odasını iptal edebilir (cancelRandomSearch).
    match /rooms/{roomCode} {
      allow get: if canGetRoom(roomCode);
      allow list: if canReadExistingRoom();
      allow create: if signedIn() && (
        (
          request.resource.data.hostUid == request.auth.uid
          && request.resource.data.status in ['waiting', 'waiting_random', 'waiting_invite']
        )
        || canCreateAcceptedInviteRoom()
      );
      allow update: if signedIn() && (
        // Mevcut oyuncu (hamle/pass/leave) — hostUid/guestUid değişmez
        (isRoomMember()
          && request.resource.data.hostUid == resource.data.hostUid)
        // Odaya katılan yeni guest (waiting → active)
        || (resource.data.status in ['waiting', 'waiting_random', 'waiting_invite']
          && request.auth.uid == request.resource.data.guestUid
          && request.resource.data.hostUid == resource.data.hostUid)
      );
      allow delete: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && resource.data.status in ['waiting', 'waiting_random', 'waiting_invite'];
    }

    // ── matches/{matchId} + messages — sohbet ────────────────────
    // (Önceki kurallar korundu; oyun durumu rooms'ta, sohbet matches'te.)
    match /matches/{matchId} {
      allow read: if isMatchPlayer(matchId);

      allow create: if signedIn()
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.unreadCounts is map;

      allow update: if isMatchPlayer(matchId)
        && request.resource.data.players == resource.data.players
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'players', 'hostUid', 'guestUid', 'createdAt', 'updatedAt',
          'lastMessage', 'lastMessageAt', 'lastMessageBy', 'unreadCounts'
        ]);

      allow delete: if false;
    }

    match /matches/{matchId}/messages/{messageId} {
      allow read: if isMatchPlayer(matchId);

      allow create: if isMatchPlayerAfter(matchId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.type == 'text'
        && request.resource.data.createdAt == request.time
        && request.resource.data.readBy is list
        && request.auth.uid in request.resource.data.readBy;

      allow update: if isMatchPlayer(matchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);

      allow delete: if false;
    }

    // ── gameInvites/{inviteId} — oyun davetleri ──────────────────
    // (Önceki kurallar korundu — katılımcı bazlı, durum geçişleri kısıtlı.)
    match /gameInvites/{inviteId} {
      allow read: if isInviteParticipant();

      allow create: if signedIn()
        && request.resource.data.inviteId == inviteId
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.fromDisplayName is string
        && request.resource.data.toDisplayName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.roomCode == null
        && request.resource.data.gameId == null;

      allow update: if signedIn()
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.fromDisplayName == resource.data.fromDisplayName
        && request.resource.data.toDisplayName == resource.data.toDisplayName
        && request.resource.data.gameType == resource.data.gameType
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && resource.data.status == 'pending'
        && (
          (
            request.auth.uid == resource.data.toUserId
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'acceptedAt', 'declinedAt', 'roomCode', 'gameId'
            ])
          )
          || (
            request.auth.uid == resource.data.fromUserId
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancelledAt'
            ])
          )
          || (
            request.auth.uid in [resource.data.fromUserId, resource.data.toUserId]
            && request.resource.data.status == 'expired'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );

      allow delete: if false;
    }

    // ── tournaments/{id} — paylaşımlı turnuva dokümanı ───────────
    // Lobi public-read; katılım/skor authenticated-write (paylaşımlı doc).
    // ⚠️ Skorlar client'tan — gerçek anti-hile Cloud Functions ister (yol haritası).
    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // ── Admin-managed / public-read referans veriler ─────────────
    // Uygulama bunlara HİÇ yazmaz; sadece okur. Yazım admin/Cloud Function-only.
    match /dailyWords/{dateKey} {
      allow read: if true;             // günün kelimesi (anon cold-start dahil)
      allow write: if false;
    }
    match /ferheng/{wordId} {
      allow read: if true;             // sözlük herkese açık
      allow write: if false;
    }
    match /ferheng_meta/{dialect} {
      allow read: if true;
      allow write: if false;
    }
    match /config/{configId} {
      allow read: if true;             // sürüm zorlama, auth öncesi okunabilir
      allow write: if false;
    }

    // ── dailyStats/{dateKey} — global agregat sayaç ──────────────
    // Public-read. Yazım: giriş yapmış (anonim dahil). Sadece sayaç; bireysel
    // hassasiyet düşük. (Rules increment-only doğrulayamaz — şişirme riski kabul.)
    match /dailyStats/{dateKey} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
